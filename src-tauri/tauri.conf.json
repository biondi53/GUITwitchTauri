{
  "productName": "Twitch Ultralight",
  "version": "1.1.47",
  "identifier": "com.twitchultraligero.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node bump-version.js && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/streamlink-portable.zip"
    ]
  }
}
